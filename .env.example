# ---------------------------------------------------------------------------
# Copy this file to ".env" for local development (never commit .env).
# On Render, these values are set in the dashboard or in render.yaml.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Development: True. Production: False.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Address the browser uses to reach the portal (used in reminder emails).
PORTAL_BASE_URL=http://localhost:8000

# --- Database ---------------------------------------------------------------
# Leave empty to use SQLite (db.sqlite3) locally.
# PostgreSQL example: postgres://USER:PASSWORD@localhost:5432/aicte_fdr
DATABASE_URL=

# --- Private documents --------------------------------------------------------
# Folder for uploaded FDR documents. Keep it outside any public folder.
PRIVATE_UPLOAD_ROOT=./private_uploads

# --- Email (SMTP) -------------------------------------------------------------
# Development: console prints emails. Production: smtp.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use TLS on port 587 (most providers). Use SSL on port 465 instead. Never both.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AICTE FDR Portal <no-reply@example.com>

# --- Optional -----------------------------------------------------------------
# Only needed when the React dev server (port 5173) talks to the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
